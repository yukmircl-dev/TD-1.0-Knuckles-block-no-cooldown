-- Función creadora de botones estándar (Spam de habilidades)
local function createAbilityButton(name, text, remoteFunc)
    local btn = Instance.new("TextButton")
    local active = false
    btn.Name = name
    btn.Parent = ScrollingFrame
    btn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    btn.Size = UDim2.new(0.9, 0, 0, 45)
    btn.Font = Enum.Font.GothamSemibold
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(0, 255, 180)
    btn.TextSize = 11
    btn.TextWrapped = true
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    btn.MouseButton1Click:Connect(function()
        active = not active
        if active then
            btn.Text = "STOP " .. name:upper()
            btn.TextColor3 = Color3.fromRGB(255, 80, 80)
            btn.BackgroundColor3 = Color3.fromRGB(45, 30, 30)
            task.spawn(function()
                while active do
                    pcall(remoteFunc)
                    task.wait(0.1)
                end
            end)
        else
            btn.Text = text
            btn.TextColor3 = Color3.fromRGB(0, 255, 180)
            btn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
        end
    end)
end

-- Función creadora especial para el Botón "Kill Trolls"
local function createKillTrollsButton()
    local btn = Instance.new("TextButton")
    local active = false
    btn.Name = "KillTrolls"
    btn.Parent = ScrollingFrame
    btn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    btn.Size = UDim2.new(0.9, 0, 0, 45)
    btn.Font = Enum.Font.GothamBold
    btn.Text = "Kill Trolls (Boss Rush/Trollbase)"
    btn.TextColor3 = Color3.fromRGB(255, 215, 0) -- Color dorado para resaltar
    btn.TextSize = 11
    btn.TextWrapped = true
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    btn.MouseButton1Click:Connect(function()
        active = not active
        if active then
            btn.Text = "STOP KILL TROLLS"
            btn.TextColor3 = Color3.fromRGB(255, 80, 80)
            btn.BackgroundColor3 = Color3.fromRGB(45, 30, 30)
            
            getgenv().G = true
            getgenv().Creator = 'https://discord.gg/B3HqPPzFYr - HalloweenGaster'
            
            task.spawn(function()
                while active and getgenv().G and getgenv().Creator == 'https://discord.gg/B3HqPPzFYr - HalloweenGaster' do
                    pcall(function()
                        sethiddenproperty(game.Players.LocalPlayer, "SimulationRadius", 112412400000)
                        sethiddenproperty(game.Players.LocalPlayer, "MaxSimulationRadius", 112412400000)
                        for _, d in pairs(game.Workspace:GetDescendants()) do
                            if d.ClassName == 'Humanoid' and d.Parent.Name ~= game.Players.LocalPlayer.Name then
                                d.Health = 0
                            end
                        end
                    end)
                    task.wait(1)
                end
            end)
        else
            active = false
            getgenv().G = false
            btn.Text = "Kill Trolls (Boss Rush/Trollbase)"
            btn.TextColor3 = Color3.fromRGB(255, 215, 0)
            btn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
        end
    end)
end

